# Copy to .env and fill in. Never commit .env.
# See the deployment notes for what each value is for.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
AUTH_ALLOWED_DOMAIN=
CLAUDE_CODE_OAUTH_TOKEN=

# Customer Proposal Portal integration (the "Send to customer portal" button +
# Customer Portal page proxy to the portal's admin API). Must match the portal's
# SERVICE_TOKEN. PORTAL_ADMIN_URL is the portal's base URL (no trailing slash).
PORTAL_ADMIN_URL=
SERVICE_TOKEN=

# Dropbox — the step-5 "To Dropbox" upload (creates the project folder in the
# Treadwell Team Dropbox + uploads the estimate/proposal/PDF). Prefer the modern
# refresh-token flow (long-lived, auto-refreshing); mint the token once with
# backend/dropbox_oauth_setup.py. DROPBOX_ACCESS_TOKEN is a legacy fallback.
# Destinations (Estimating category folders) are hardcoded in dropbox_client.py.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# DROPBOX_ACCESS_TOKEN=       # legacy alternative to the refresh-token trio

# Morning follow-up digest — one email per estimator, at most five proposals,
# ranked by digest_worker.py and sent by the portal. All optional; the defaults
# below are what the code uses. Set DIGEST_ENABLED=off to hold it back on an
# environment (the /api/admin/digest/preview endpoint still works, so the ranking
# can be reviewed without emailing anyone).
# DIGEST_ENABLED=on
# DIGEST_HOUR=6               # hour in America/Chicago; sends on the first tick after
# DIGEST_MIN_SCORE=40         # 0-100; below this a proposal isn't recommended
# DIGEST_MAX_ITEMS=5          # per estimator per morning

# Driving distance from the Olathe office to a job (Polish estimate, Labor step). Works with NO key:
# the US Census geocoder + the OSRM public router (both free, called server-side). Set a Google Maps
# key only if you want Google Routes tried first (the free pair is then the fallback). When every
# service fails the estimator is asked to type the miles; nothing is guessed.
# GOOGLE_MAPS_API_KEY=

# Project Calendar (backend/project_calendar.py) — a READ-ONLY view of ONE Google calendar, the
# crews' job schedule. Connects as a Google service account that has been shared that calendar
# only (scope calendar.events.readonly). Leave these blank and the page says "not connected".
# Never commit a real calendar id or key: this repo is public.
# The calendar's id, from its Google settings (looks like <id>@group.calendar.google.com).
PROJECT_CALENDAR_ID=
# The service-account key: its JSON text on one line, OR a path to the key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Prefer GOOGLE_SERVICE_ACCOUNT_JSON in the host .env. If you use a file instead, keep it OUT of
# /app/data: that volume is backed up off the box twice a day.
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/<key-file>.json
# Seconds a fetched range is reused before Google is asked again.
# PROJECT_CALENDAR_TTL_S=300
