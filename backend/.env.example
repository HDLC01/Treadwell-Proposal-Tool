# Copy to .env and fill in. Never commit .env.
# See the deployment notes for what each value is for.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
AUTH_ALLOWED_DOMAIN=
CLAUDE_CODE_OAUTH_TOKEN=

# Customer Proposal Portal integration (the "Send to customer portal" button +
# Customer Portal page proxy to the portal's admin API). Must match the portal's
# SERVICE_TOKEN. PORTAL_ADMIN_URL is the portal's base URL (no trailing slash).
PORTAL_ADMIN_URL=
SERVICE_TOKEN=

# Dropbox — the step-5 "To Dropbox" upload (creates the project folder in the
# Treadwell Team Dropbox + uploads the estimate/proposal/PDF). Prefer the modern
# refresh-token flow (long-lived, auto-refreshing); mint the token once with
# backend/dropbox_oauth_setup.py. DROPBOX_ACCESS_TOKEN is a legacy fallback.
# Destinations (Estimating category folders) are hardcoded in dropbox_client.py.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# DROPBOX_ACCESS_TOKEN=       # legacy alternative to the refresh-token trio

# Morning follow-up digest — one email per estimator, at most five proposals,
# ranked by digest_worker.py and sent by the portal. All optional; the defaults
# below are what the code uses. Set DIGEST_ENABLED=off to hold it back on an
# environment (the /api/admin/digest/preview endpoint still works, so the ranking
# can be reviewed without emailing anyone).
# DIGEST_ENABLED=on
# DIGEST_HOUR=6               # hour in America/Chicago; sends on the first tick after
# DIGEST_MIN_SCORE=40         # 0-100; below this a proposal isn't recommended
# DIGEST_MAX_ITEMS=5          # per estimator per morning
