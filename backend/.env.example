# Copy to .env and fill in. Never commit .env.
# See the deployment notes for what each value is for.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
AUTH_ALLOWED_DOMAIN=
CLAUDE_CODE_OAUTH_TOKEN=

# Customer Proposal Portal integration (the "Send to customer portal" button +
# Customer Portal page proxy to the portal's admin API). Must match the portal's
# SERVICE_TOKEN. PORTAL_ADMIN_URL is the portal's base URL (no trailing slash).
PORTAL_ADMIN_URL=
SERVICE_TOKEN=

# Dropbox — the step-5 "To Dropbox" upload (creates the project folder in the
# Treadwell Team Dropbox + uploads the estimate/proposal/PDF). Prefer the modern
# refresh-token flow (long-lived, auto-refreshing); mint the token once with
# backend/dropbox_oauth_setup.py. DROPBOX_ACCESS_TOKEN is a legacy fallback.
# Destinations (Estimating category folders) are hardcoded in dropbox_client.py.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# DROPBOX_ACCESS_TOKEN=       # legacy alternative to the refresh-token trio

# Morning follow-up digest — one email per estimator, at most five proposals,
# ranked by digest_worker.py and sent by the portal. All optional; the defaults
# below are what the code uses. Set DIGEST_ENABLED=off to hold it back on an
# environment (the /api/admin/digest/preview endpoint still works, so the ranking
# can be reviewed without emailing anyone).
# DIGEST_ENABLED=on
# DIGEST_HOUR=6               # hour in America/Chicago; sends on the first tick after
# DIGEST_MIN_SCORE=40         # 0-100; below this a proposal isn't recommended
# DIGEST_MAX_ITEMS=5          # per estimator per morning

# Driving distance from the Olathe office to a job (Polish estimate, Labor step). Works with NO key:
# the US Census geocoder + the OSRM public router (both free, called server-side). Set a Google Maps
# key only if you want Google Routes tried first (the free pair is then the fallback). When every
# service fails the estimator is asked to type the miles; nothing is guessed.
# GOOGLE_MAPS_API_KEY=

# Project Calendar (backend/project_calendar.py) — a READ-ONLY view of ONE Google calendar, the
# Project Calendar (scope calendar.events.readonly). Leave these blank and the page says "not
# connected". Never commit a real calendar id, secret, token or key: this repo is public.
# Two ways to connect; when the three GOOGLE_OAUTH_* values are all set they WIN over the service
# account. One or two of them set = not connected (the log says how many are missing).
# The calendar's id, from its Google settings (looks like <id>@group.calendar.google.com).
# The setup script refuses "primary" or any id that does not end with @group.calendar.google.com.
PROJECT_CALENDAR_ID=
# 1) As the calendar's owner (the live setup): a Google sign-in, read-only, this calendar only.
#    One-time setup, on your own PC:
#    - Google Cloud > APIs & Services > Library: enable "Google Calendar API" (without it every
#      read is a 403 and the page says the API is turned off).
#    - Google Cloud > OAuth consent screen: user type "Internal" (an External app in Testing
#      expires the sign-in after 7 days). If Internal is unavailable: External, then "Publish app".
#    - Credentials > Create OAuth client ID > "Desktop app" (not "Web application"); download its JSON.
#    - Run: backend/.venv/Scripts/python.exe backend/google_calendar_oauth.py --client-file <json>
#      and sign in with the Google account that OWNS the calendar.
#    - It writes ~/.treadwell/google-calendar-oauth.env, in your home folder, OUTSIDE the repo
#      (an --out inside the repo is refused unless git ignores it). Copy its three lines into
#      the host .env, then delete the file.
#    When the Project Calendar page says the sign-in "has expired or was removed", run the script
#    again and replace the three lines. "Can only see free/busy times": run it again signed in as
#    the calendar's OWNER. "The Google Calendar API is turned off": the Library step above.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# 2) As a Google service account shared the calendar. A Workspace that caps outside sharing at
#    free/busy hides every title and colour from it, so it is the fallback, not the live setup.
# The service-account key: its JSON text on one line, OR a path to the key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Prefer GOOGLE_SERVICE_ACCOUNT_JSON in the host .env. If you use a file instead, keep it OUT of
# /app/data: that volume is backed up off the box twice a day.
# GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/<key-file>.json
# Seconds a fetched range is reused before Google is asked again.
# PROJECT_CALENDAR_TTL_S=300

# Connect Raken (backend/raken.py, #781) - Project Analytics' Plan vs Actual reads labor from Raken.
# An admin presses "Connect Raken" on the Project Analytics page; the server keeps that sign-in,
# encrypted, in raken_signin.json on the data volume and renews it by itself. Leave these blank and
# the page says Raken is not set up. Never commit a real value: this repo is public.
# The Raken API app's client id and secret (Raken developer settings).
RAKEN_CLIENT_ID=
RAKEN_CLIENT_SECRET=
# Where Raken sends the admin back: this server's /api/raken/callback, for example
# https://staging.proposals.wetreadwell.com/api/raken/callback on staging. Register it on the app.
RAKEN_REDIRECT_URI=
# The key that encrypts the stored sign-in. Make one with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it OUT of /app/data (that volume is backed up off the box). Changing it means an admin must
# Connect Raken again.
RAKEN_TOKEN_KEY=
# Seconds the "Connected: N Raken projects" check is reused before Raken is asked again.
# RAKEN_STATUS_TTL_S=600
# Plan vs Actual's daily refresh (backend/pva_refresh_worker.py, #784): at 5:00 AM Central it runs
# the same step as "Refresh now" (the calendar and Raken), once a day, and keeps a snapshot of each
# job's figures in the pva_snapshots table (backend/ops/pva_snapshots.sql). On unless switched off.
# PVA_REFRESH_ENABLED=on

# BD CRM (backend/bd/config.py, #802). Every BD setting carries the BD_ prefix, so none is ever
# confused with a proposal-tool setting above; BD never reads SUPER_ADMIN_EMAIL or any other
# unprefixed name. Blank = unset, and unset means the default named on each line.
# BD's Postgres login (bd_app, search_path bd). Unset: every BD route answers 503.
BD_DATABASE_URL=
# BD's connection pool sizes. Default 1 and 5.
BD_DB_POOL_MIN=
BD_DB_POOL_MAX=
# The Friday weekly-10 batch. Default off; prod turns it on at cut-over, staging leaves it off.
BD_WEEKLY_ENABLED=
# Hour (0-23, Central) from which the Friday batch may run, when BD's settings hold none. Default 16.
BD_WEEKLY_HOUR=
# BD's sign-in bootstrap: the super admin, and comma-separated admins, given a BD role on their
# first sign-in. Leave both unset on staging and prod: nobody gets a BD role from the environment.
BD_SUPER_ADMIN_EMAIL=
BD_ADMIN_EMAILS=
# Read only by BD's telephony status panel (quo or null). Never commit a real key or secret.
BD_TELEPHONY_PROVIDER=
BD_QUO_API_KEY=
BD_QUO_WEBHOOK_SECRET=
# TESTS ONLY, never on a server: a fixed "today" (YYYY-MM-DD, Central) and "now" (ISO 8601 with
# offset) for BD's business clock.
BD_TODAY=
BD_NOW=
# TESTS ONLY: an ADMIN url of a Postgres the BD tests create and drop their own databases on.
# Unset: the BD database tests skip locally (CI sets it and fails without it).
BD_TEST_DATABASE_URL=
