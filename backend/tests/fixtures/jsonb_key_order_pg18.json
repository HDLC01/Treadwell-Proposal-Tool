{
 "meta": {
  "what": "What a real PostgreSQL's jsonb does to the order of an object's keys: each `server` is `select '<input>'::jsonb::text` run on the server named below. The harness helper tests/js/_jsonb.js must put the keys of `input` in exactly the order `server` has them (as a browser reads that text).",
  "server": "PostgreSQL 18.2 on x86_64-windows, compiled by msvc-19.44.35222, 64-bit",
  "recorded": "2026-10-20",
  "how": "initdb a throwaway cluster, start it on a private port, and run each input through `select '<input>'::jsonb::text` with psql; the answers are copied here as the server returned them"
 },
 "cases": [
  {
   "name": "documented example (PostgreSQL manual, 8.14.1)",
   "input": "{\"bar\": \"baz\", \"balance\": 7.77, \"active\":false}",
   "server": "{\"bar\": \"baz\", \"active\": false, \"balance\": 7.77}"
  },
  {
   "name": "shorter keys first",
   "input": "{\"bb\":1,\"a\":2,\"ccc\":3,\"aa\":4,\"\":0}",
   "server": "{\"\": 0, \"a\": 2, \"aa\": 4, \"bb\": 1, \"ccc\": 3}"
  },
  {
   "name": "equal lengths by their bytes",
   "input": "{\"b\":1,\"a\":2,\"B\":3,\"A\":4,\"_\":5}",
   "server": "{\"A\": 4, \"B\": 3, \"_\": 5, \"a\": 2, \"b\": 1}"
  },
  {
   "name": "length is in BYTES: e-acute and the euro sign",
   "input": "{\"é\":1,\"zz\":2,\"b\":3,\"€\":4,\"ab\":5,\"abc\":6}",
   "server": "{\"b\": 3, \"ab\": 5, \"zz\": 2, \"é\": 1, \"abc\": 6, \"€\": 4}"
  },
  {
   "name": "a two byte character against two ASCII ones",
   "input": "{\"zz\":1,\"é\":2}",
   "server": "{\"zz\": 1, \"é\": 2}"
  },
  {
   "name": "a four byte character",
   "input": "{\"😀\":1,\"ab\":2,\"zzz\":3,\"abcd\":4}",
   "server": "{\"ab\": 2, \"zzz\": 3, \"abcd\": 4, \"😀\": 1}"
  },
  {
   "name": "the sheets of a bid",
   "input": "{\"Gyp (USG 1-8\\\")\":1,\"Epoxy\":2,\"Copy1\":3,\"Copy2\":4,\"Copy10\":5,\"Polish 2\":6,\"Gyp (base)\":7,\"Seal\":8}",
   "server": "{\"Seal\": 8, \"Copy1\": 3, \"Copy2\": 4, \"Epoxy\": 2, \"Copy10\": 5, \"Polish 2\": 6, \"Gyp (base)\": 7, \"Gyp (USG 1-8\\\")\": 1}"
  },
  {
   "name": "the staging pair",
   "input": "{\"Gyp (base)\":1,\"Polish 2\":2}",
   "server": "{\"Polish 2\": 2, \"Gyp (base)\": 1}"
  },
  {
   "name": "Copy1 before Epoxy before the Gyp preset",
   "input": "{\"Gyp (USG 1-8\\\")\":1,\"Epoxy\":2,\"Copy1\":3}",
   "server": "{\"Copy1\": 3, \"Epoxy\": 2, \"Gyp (USG 1-8\\\")\": 1}"
  },
  {
   "name": "nested objects and arrays",
   "input": "{\"zz\":[{\"b\":1,\"a\":{\"yy\":1,\"x\":2}},3,null,\"s\"],\"a\":{\"ccc\":1,\"bb\":2,\"a\":3},\"n\":null,\"t\":true}",
   "server": "{\"a\": {\"a\": 3, \"bb\": 2, \"ccc\": 1}, \"n\": null, \"t\": true, \"zz\": [{\"a\": {\"x\": 2, \"yy\": 1}, \"b\": 1}, 3, null, \"s\"]}"
  },
  {
   "name": "keys that are numbers",
   "input": "{\"b\":1,\"10\":2,\"a\":3,\"2\":4,\"1\":5,\"100\":6}",
   "server": "{\"1\": 5, \"2\": 4, \"a\": 3, \"b\": 1, \"10\": 2, \"100\": 6}"
  },
  {
   "name": "a key spelled __proto__",
   "input": "{\"zzzz\": 1, \"__proto__\": {\"polluted\": true}, \"a\": 2}",
   "server": "{\"a\": 2, \"zzzz\": 1, \"__proto__\": {\"polluted\": true}}"
  },
  {
   "name": "keys that differ only in case",
   "input": "{\"epoxy\":1,\"Epoxy\":2,\"EPOXY\":3,\"Copy1\":4,\"copy1\":5}",
   "server": "{\"Copy1\": 4, \"EPOXY\": 3, \"Epoxy\": 2, \"copy1\": 5, \"epoxy\": 1}"
  },
  {
   "name": "a long key and short ones",
   "input": "{\"aaaaaaaaaaaaaaaa\":1,\"b\":2,\"cc\":3,\"dddddddd\":4}",
   "server": "{\"b\": 2, \"cc\": 3, \"dddddddd\": 4, \"aaaaaaaaaaaaaaaa\": 1}"
  },
  {
   "name": "a draft's own keys",
   "input": "{\"work_type\":\"combo\",\"polish_estimate\":{\"version\":2,\"tabs\":{\"Epoxy\":{\"seq\":1,\"layout\":\"epoxy\"},\"Copy1\":{\"seq\":2,\"layout\":\"polish\"}}},\"priced_tabs\":[{\"id\":\"Epoxy\",\"kind\":\"base\"},{\"id\":\"Copy1\",\"kind\":\"option\"}],\"tab_opts\":{\"Copy1\":{\"is_option\":true},\"Epoxy\":{\"is_option\":false}},\"cell_values\":{\"Epoxy!B6\":\"No\",\"Polish!B4\":\"Yes\"}}",
   "server": "{\"tab_opts\": {\"Copy1\": {\"is_option\": true}, \"Epoxy\": {\"is_option\": false}}, \"work_type\": \"combo\", \"cell_values\": {\"Epoxy!B6\": \"No\", \"Polish!B4\": \"Yes\"}, \"priced_tabs\": [{\"id\": \"Epoxy\", \"kind\": \"base\"}, {\"id\": \"Copy1\", \"kind\": \"option\"}], \"polish_estimate\": {\"tabs\": {\"Copy1\": {\"seq\": 2, \"layout\": \"polish\"}, \"Epoxy\": {\"seq\": 1, \"layout\": \"epoxy\"}}, \"version\": 2}}"
  }
 ]
}
